# Banco usado pela aplicação fora do ambiente de testes
DATABASE_URL=postgresql://usuario:senha@localhost:5432/gerenciador_tarefas

# Banco exclusivo para npm test (a suíte limpa as tabelas antes de rodar)
TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/gerenciador_tarefas_test

# Gere um valor aleatório e mantenha-o fora do controle de versão
JWT_SECRET=troque-por-um-segredo-aleatorio

# Opcional; padrão 3000
PORT=3000

# Opcional; usado para autorizar uma origem adicional no CORS
# FRONTEND_URL=http://localhost:3000
